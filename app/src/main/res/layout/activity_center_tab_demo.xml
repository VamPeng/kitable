<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- 标题栏 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/center_tab_demo_title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#212121"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp"
        android:background="#FFFFFF" />

    <!-- 说明文案 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/center_tab_demo_desc"
        android:textSize="13sp"
        android:textColor="#888888"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp" />

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <!-- CenterTabView 展示区域（白色背景卡片） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#FFFFFF"
        android:layout_marginTop="16dp"
        android:paddingVertical="20dp">

        <!-- Tab 控件 -->
        <com.vam.demov.tab.CenterTabView
            android:id="@+id/centerTabView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false" />

    </LinearLayout>

    <!-- 分割线 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0"
        android:layout_marginTop="8dp" />

    <!-- 状态显示 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/center_tab_demo_status_init"
        android:textSize="13sp"
        android:textColor="#555555"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp" />

    <!-- 操作按钮区域 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <!-- 上一个 -->
        <Button
            android:id="@+id/btnPrev"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/center_tab_demo_prev"
            android:textSize="13sp"
            android:backgroundTint="#1976D2"
            android:layout_marginEnd="8dp" />

        <!-- 下一个 -->
        <Button
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/center_tab_demo_next"
            android:textSize="13sp"
            android:backgroundTint="#1976D2" />

    </LinearLayout>

    <!-- 跳转指定 index 按钮行 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp">

        <Button
            android:id="@+id/btnSelect0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="视频"
            android:textSize="12sp"
            android:backgroundTint="#455A64"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnSelect1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="照片"
            android:textSize="12sp"
            android:backgroundTint="#455A64" />

    </LinearLayout>

</LinearLayout>
