<?xml version="1.0" encoding="utf-8"?>
<!--
    演示页布局
    - 根布局：ConstraintLayout 铺满屏幕
    - 顶部操作区：标题 + 描述 + 按钮 + 状态文字（wrap_content，固定在顶部）
    - 活动区 FrameLayout：宽度铺满，高度为父布局 2/3（通过 0dp + percentHeight 实现），clipChildren=true
    - FourCornerView：固定在活动区左下角（layout_gravity="bottom|start"），120x80dp
-->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 操作区：标题 -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="20dp"
        android:text="@string/dialog_top_lift_page_title"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 操作区：描述 -->
    <TextView
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:text="@string/dialog_top_lift_page_desc"
        android:textColor="#616161"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- 操作区：弹出按钮 -->
    <Button
        android:id="@+id/btnShowDialog"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="20dp"
        android:backgroundTint="#00897B"
        android:text="@string/dialog_top_lift_show_dialog"
        android:textSize="14sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvDesc" />

    <!-- 操作区：状态文字 -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="20dp"
        android:text="@string/dialog_top_lift_status_idle"
        android:textColor="#424242"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnShowDialog" />

    <!--
        活动区 FrameLayout：
        - 宽度铺满父布局
        - 高度 = 父布局高度 × 2/3（app:layout_constraintHeight_percent="0.667"）
        - clipChildren=true（超出不显示）
        - 背景用于直观展示活动区边界
    -->
    <FrameLayout
        android:id="@+id/flActivityArea"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#E3F2FD"
        android:clipChildren="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.667"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvStatus"
        app:layout_constraintVertical_bias="1.0">

        <!--
            目标 View（FourCornerView）：
            - 固定在活动区左下角（layout_gravity="bottom|start"）
            - 宽 120dp，高 80dp
        -->
        <com.vam.demov.view.FourCornerView
            android:id="@+id/vTarget"
            android:layout_width="120dp"
            android:layout_height="80dp"
            android:layout_gravity="bottom|start" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
