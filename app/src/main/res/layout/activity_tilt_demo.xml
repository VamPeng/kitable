<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <!-- 状态提示文字 -->
    <TextView
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="倾斜手机查看效果"
        android:textSize="16sp"
        android:textColor="#666666"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="48dp"
        tools:ignore="HardcodedText" />

    <!-- 当前 Roll 角度显示 -->
    <TextView
        android:id="@+id/tvAngle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Roll: 0.0°"
        android:textSize="14sp"
        android:textColor="#999999"
        android:fontFamily="monospace"
        app:layout_constraintTop_toBottomOf="@id/tvHint"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="8dp"
        tools:ignore="HardcodedText" />

    <!-- 监听开关按钮 -->
    <Button
        android:id="@+id/btnSensorToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="监听：开启（点击停止）"
        android:textSize="13sp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvAngle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="HardcodedText" />

    <!-- 当前状态标签 -->
    <TextView
        android:id="@+id/tvState"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="State: D（默认竖直）"
        android:textSize="14sp"
        android:textColor="#333333"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/boundaryArea"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        tools:ignore="HardcodedText" />

    <!--
        活动区域（boundary）
        蓝色描边矩形，作为 TiltViewController boundaryRect 的视觉参考。
        View 的左下角将始终与此区域的左下角对齐。
    -->
    <FrameLayout
        android:id="@+id/boundaryArea"
        android:layout_width="0dp"
        android:layout_height="360dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@drawable/bg_boundary_area"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 左下角参考点标记（橙红色小方块） -->
        <View
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="bottom|start"
            android:background="#FF5722" />

        <!-- 左下角说明文字 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="4dp"
            android:text="← View 左下角对齐此处"
            android:textSize="11sp"
            android:textColor="#888888"
            tools:ignore="HardcodedText" />

        <!--
            目标 View（由 TiltViewController 控制旋转和平移）
            四角显示 1-4 数字，直观验证旋转和左下角对齐效果。
            初始居中放置，bind() 后会立即同步到左下角对齐位置。
        -->
        <com.vam.demov.view.FourCornerView
            android:id="@+id/targetView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:elevation="4dp"
            app:fcv_width="120dp"
            app:fcv_height="80dp" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
